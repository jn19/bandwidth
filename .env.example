# GitHub — uses gh CLI auth (run `gh auth login` once, no token needed here)
# Set to false to hide assigned issues and only show PRs
GITHUB_INCLUDE_ISSUES=true

# Jira — generate at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_HOST=yourcompany.atlassian.net
JIRA_EMAIL=you@yourcompany.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEYS=PROJ1,PROJ2

# Jira project that gets its own dedicated category column
JIRA_SPOTLIGHT_PROJECT=SOC

# Git worktrees — parent directory of your local repos
# e.g. if you have ~/development/my-app, set this to ~/development
LOCAL_REPO_BASE=~/development

PORT=3001
# Listen address. Keep it on loopback unless you add authentication.
HOST=127.0.0.1

# Optional: scoped Jira API tokens must use Atlassian's gateway (links still use JIRA_HOST)
# JIRA_API_BASE=https://api.atlassian.com/ex/jira/your-cloud-id
# JIRA_READ_ONLY=true

# Optional: list Claude Code sessions by project folder (colon-separated)
# CLAUDE_PROJECT_DIRS=~/projects
# CLAUDE_PROJECT_DAYS=14

# Optional: markdown notes linked to Jira issues by `tickets: [KEY-1]` frontmatter
# NOTES_DIR=~/notes
# BRIEF_APPENDIX_FILE=~/bandwidth-brief-extra.md

# Linux/WSL: terminal launcher for Resume / Assign to Claude
# BANDWIDTH_LAUNCHER=/path/to/bandwidth/scripts/launch-wsl-terminal.sh
# BANDWIDTH_TMUX=1
